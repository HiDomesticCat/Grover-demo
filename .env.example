#############################
# Grover's Algorithm Visualizer Configuration
#############################

#-----------------------------
# Frontend Configuration
#-----------------------------
# Vite requires env vars to be prefixed with VITE_
# URL to connect to backend (required)
VITE_BACKEND_URL=http://localhost:8000

# Debug mode (enables additional logging)
VITE_DEBUG_MODE=false

# Maximum number of qubits to allow (optional, defaults to 10)
VITE_MAX_QUBITS=8

#-----------------------------
# Backend Configuration
#-----------------------------
# Gemini API key for AI explanations (required for AI features)
# Get it from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# CORS origins (comma-separated, required)
# Add all frontend URLs that will access the backend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000,http://192.168.15.101:3000

# Allow all origins for development (set to "true" during development, "false" in production)
ALLOW_ALL_ORIGINS=true

# Server port (optional, defaults to 8000)
PORT=8000

# Log level (optional, defaults to info)
# Options: debug, info, warning, error, critical
LOG_LEVEL=info

# Maximum allowed qubits to simulate (optional, defaults to 10)
MAX_QUBITS=10

#-----------------------------
# Advanced Settings
#-----------------------------
# Default noise model for simulations (optional)
# Options: thermal, depolarizing, custom
DEFAULT_NOISE_MODEL=depolarizing

# Default noise level (optional, 0-1)
DEFAULT_NOISE_LEVEL=0.005
